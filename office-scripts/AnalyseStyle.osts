{"version":"0.3.0","body":"/**\n * ANALYSE STYLE\n * Reads up to 5 example reports, anonymizes names (client-side + AI),\n * focuses solely on the teacher’s writing style, and sends them to\n * OpenAI to build a tone & linguistic profile. Writes:\n *   • Summary → Settings!B5\n *   • JSON profile → Settings!B6\n */\n\ninterface StyleProfile {\n  toneDescriptors: string[];\n  avgSentenceLength: number;\n  vocabComplexity: string;\n  sentenceStructures: string[];\n  commonPhrases: string[];\n}\n\nasync function main(workbook: ExcelScript.Workbook) {\n  // 1. Credentials & model settings\n  const names = workbook.getNames();\n  const apiKey = names.find(n => n.getName() === \"OpenAI_Key\")!\n    .getRange().getValue() as string;\n  const model = names.find(n => n.getName() === \"Model\")!\n    .getRange().getValue() as string;\n  const temp = Number(names.find(n => n.getName() === \"Temperature\")!\n    .getRange().getValue() as string);\n  const freq = Number(names.find(n => n.getName() === \"FreqPenalty\")!\n    .getRange().getValue() as string);\n  const pres = Number(names.find(n => n.getName() === \"PresPenalty\")!\n    .getRange().getValue() as string);\n\n  const settings = workbook.getWorksheet(\"Settings\")!;\n\n  // 2. Check EnableEmulation\n  const emRaw = names.find(n => n.getName() === \"EnableEmulation\")!\n    .getRange().getValue() as boolean | string | number;\n  const emulate: boolean =\n    typeof emRaw === \"boolean\" ? emRaw :\n      typeof emRaw === \"string\" ? (emRaw.toUpperCase() === \"TRUE\" || emRaw === \"1\") :\n        emRaw !== 0;\n\n  if (!emulate) {\n    settings.getRange(\"D3\").setValue(\"Style emulation disabled.\");\n    settings.getRange(\"F3\").clear();\n    return;\n  }\n\n  // 3. Gather & validate examples\n  const exVals = names.find(n => n.getName() === \"StyleExamples\")!\n    .getRange().getValues() as (string | number)[][];\n  const examples = (exVals[0] as (string | number)[])\n    .map(x => String(x).trim())\n    .filter(txt => txt !== \"\");\n  if (examples.length === 0) {\n    settings.getRange(\"D3\").setValue(\"Enter at least one example report and rerun.\");\n    settings.getRange(\"F3\").clear();\n    return;\n  }\n  if (examples.length > 5) {\n    settings.getRange(\"D3\").setValue(\"Limit examples to 5 or fewer.\");\n    settings.getRange(\"F3\").clear();\n    return;\n  }\n\n  // 4. Client-side anonymization of obvious names\n  const nameRegex = /\\b[A-Z][a-z]+(?:\\s[A-Z][a-z]+)*\\b/g;\n  const scrubbed = examples.map(txt => txt.replace(nameRegex, \"[Name]\"));\n\n  // 5. Build the AI prompt\n  let prompt = `You will receive 1–5 example reports. Ignore the content/topics (e.g. anything about students). Focus solely on the teacher’s writing style and use of language.\n\nDo NOT include any headers like “Summary:” or “JSON Object:” in your reply. Output exactly two things, in this order:\n1. A concise summary of tone & linguistic style (no header).\n2. A JSON object with ONLY these keys: toneDescriptors, avgSentenceLength, vocabComplexity, sentenceStructures, commonPhrases.\n\n===\n\n`;\n  scrubbed.forEach((txt, i) => {\n    prompt += `Report ${i + 1}: \"\"\"${txt}\"\"\"\\n\\n`;\n  });\n\n  // 6. Call OpenAI API\n  const resp = await fetch(\"https://api.openai.com/v1/chat/completions\", {\n    method: \"POST\",\n    headers: {\n      \"Content-Type\": \"application/json\",\n      \"Authorization\": `Bearer ${apiKey}`\n    },\n    body: JSON.stringify({\n      model,\n      temperature: temp,\n      frequency_penalty: freq,\n      presence_penalty: pres,\n      messages: [{ role: \"user\", content: prompt }],\n      max_tokens: 512\n    })\n  });\n  if (!resp.ok) throw new Error(await resp.text());\n  const jr = (await resp.json()) as { choices: { message: { content: string } }[] };\n  const text = jr.choices[0].message.content;\n\n  // 7. Extract JSON & clean summary\n  const jsonMatch = text.match(/\\{[\\s\\S]*\\}/);\n  if (!jsonMatch) throw new Error(\"No JSON object in response.\");\n  const jsonText = jsonMatch[0];\n\n  let summary = text\n    .replace(jsonText, \"\")\n    .trim()\n    .replace(/^\\s*\\*\\*?Summary[:\\*]+\\**\\s*/i, \"\")\n    .replace(/\\s*\\*\\*?JSON Object[:\\*]+\\**[\\s\\S]*$/i, \"\")\n    .trim();\n\n  const pwdItem = workbook.getNames().find(n => n.getName() === \"ProtectionPwd\");\n  if (!pwdItem) throw new Error(\"Named range 'ProtectionPwd' not found.\");\n  const pwd: string = String(pwdItem.getRange().getValue() ?? \"\");\n\n\n  // Access the protection object\n  let sheetProtection = settings.getProtection();\n\n  // Unprotect the worksheet using the password\n  sheetProtection.unprotect(pwd);\n\n\n\n  // 8. Write back to Settings\n  settings.getRange(\"D3\").setValue(summary);\n  settings.getRange(\"F3\").setValue(jsonText);\n\n  sheetProtection.protect(\n    {\n      selectionMode: ExcelScript.ProtectionSelectionMode.unlocked\n    },pwd);\n}","description":"","parameterInfo":"{\"version\":1,\"originalParameterOrder\":[],\"parameterSchema\":{\"type\":\"object\",\"default\":{},\"x-ms-visibility\":\"internal\"},\"returnSchema\":{\"type\":\"object\",\"properties\":{}},\"signature\":{\"comment\":\"\",\"parameters\":[{\"name\":\"workbook\",\"comment\":\"\"}]}}","apiInfo":"{\"variant\":\"synchronous\",\"variantVersion\":2}"}