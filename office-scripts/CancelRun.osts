{"version":"0.3.0","body":"/**\n * CancelRun.ts\n * Sets the CancelFlag to TRUE so RunReports can abort at its next checkpoint.\n */\nfunction main(workbook: ExcelScript.Workbook): void {\n    const item = workbook.getNames().find(n => n.getName() === \"CancelFlag\");\n    if (item) item.getRange().setValue(\"TRUE\");\n}","description":"","parameterInfo":"{\"version\":1,\"originalParameterOrder\":[],\"parameterSchema\":{\"type\":\"object\",\"default\":{},\"x-ms-visibility\":\"internal\"},\"returnSchema\":{\"type\":\"object\",\"properties\":{}},\"signature\":{\"comment\":\"CancelRun.ts\\nSets the CancelFlag to TRUE so RunReports can abort at its next checkpoint.\",\"parameters\":[{\"name\":\"workbook\",\"comment\":\"\"}]}}","apiInfo":"{\"variant\":\"synchronous\",\"variantVersion\":2}"}