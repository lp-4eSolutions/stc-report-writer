{"version":"0.3.0","body":"/**\n * ClearContents.ts v1.3\n * Clears all values (not formatting or validation) from the ReportsData range,\n * auto-fits each row with content in that range and adds 20pt padding,\n * and sets all regenerate flags in the RegenFlags range to FALSE.\n */\n\nasync function main(workbook: ExcelScript.Workbook): Promise<void> {\n  // 0. Unprotect workbook\n  const pwdItem = workbook.getNames().find(n => n.getName() === \"ProtectionPwd\");\n  if (!pwdItem) throw new Error(\"Named range 'ProtectionPwd' not found.\");\n  const pwd = String(pwdItem.getRange().getValue() ?? \"\");\n  workbook.getProtection().unprotect(pwd);\n\n  // 1. Unprotect the Reports sheet\n  const ws = workbook.getWorksheet(\"Reports\");\n  if (!ws) throw new Error(\"Worksheet 'Reports' not found.\");\n  ws.getProtection().unprotect(pwd);\n\n  // 2. Blank out only the values in ReportsData (preserves data validation & formatting)\n  const dataItem = workbook.getNames().find(n => n.getName() === \"ReportsData\");\n  if (!dataItem) throw new Error(\"Named range 'ReportsData' not found.\");\n  const dataRange = dataItem.getRange();\n  const rowCount = dataRange.getRowCount();\n  const colCount = dataRange.getColumnCount();\n  // build a matrix of empty strings\n  const blankMatrix = Array.from({ length: rowCount }, () => Array(colCount).fill(\"\"));\n  dataRange.setValues(blankMatrix);\n\n  // 3. Auto-fit + 20pt padding for each non-empty row in ReportsData\n  const firstRowIndex = dataRange.getRowIndex();\n  for (let i = 0; i < rowCount; i++) {\n    ws\n    .getRangeByIndexes(firstRowIndex + i, 0, 1, 1)\n    .getFormat()\n    .setRowHeight(25);\n  }\n  // 4. Reset all regenerate flags to FALSE\n  const regenItem = workbook.getNames().find(n => n.getName() === \"RegenFlags\");\n  if (!regenItem) throw new Error(\"Named range 'RegenFlags' not found.\");\n  const regenRange = regenItem.getRange();\n  const regenRows = regenRange.getRowCount();\n  const regenValues: boolean[][] = Array.from({ length: regenRows }, () => [false]);\n  regenRange.setValues(regenValues);\n\n  // 5. Re-protect the Reports sheet (allowing only select unlocked cells & formatting)\n  ws.getProtection().protect(\n    {\n      selectionMode: ExcelScript.ProtectionSelectionMode.unlocked, allowFormatCells: true,\n      allowFormatRows: true,\n      allowFormatColumns: true,\n    }, pwd);\n\n  // 6. Re-protect workbook\n  workbook.getProtection().protect(pwd);\n}","description":"","parameterInfo":"{\"version\":1,\"originalParameterOrder\":[],\"parameterSchema\":{\"type\":\"object\",\"default\":{},\"x-ms-visibility\":\"internal\"},\"returnSchema\":{\"type\":\"object\",\"properties\":{}},\"signature\":{\"comment\":\"ClearContents.ts v1.3\\nClears all values (not formatting or validation) from the ReportsData range,\\nauto-fits each row with content in that range and adds 20pt padding,\\nand sets all regenerate flags in the RegenFlags range to FALSE.\",\"parameters\":[{\"name\":\"workbook\",\"comment\":\"\"}]}}","apiInfo":"{\"variant\":\"synchronous\",\"variantVersion\":2}"}