{"version":"0.3.0","body":"/**\n * ResetReports.ts v1.0\n * Restores the RunReports button and BusyFlag to their original defaults\n * by reading the JSON stored in the named range RunReportsDefaults.\n */\n\nasync function main(workbook: ExcelScript.Workbook): Promise<void> {\n    // 1. Unprotect workbook\n    const pwdItem = workbook.getNames().find(n => n.getName() === \"ProtectionPwd\");\n    if (!pwdItem) throw new Error(\"Named range 'ProtectionPwd' not found.\");\n    const pwd: string = String(pwdItem.getRange().getValue() ?? \"\");\n    workbook.getProtection().unprotect(pwd);\n\n  const reports = workbook.getWorksheet(\"Reports\")!;\n\n\n  // Access the protection object\n  let sheetProtection = reports.getProtection();\n\n  // Unprotect the worksheet using the password\n  sheetProtection.unprotect(pwd);\n\n    // 2. Reset BusyFlag\n    const busyItem = workbook.getNames().find(n => n.getName() === \"BusyFlag\");\n    if (busyItem) busyItem.getRange().setValue(\"FALSE\");\n\n    // 3. Read defaults JSON\n    const defItem = workbook.getNames().find(n => n.getName() === \"RunReportsDefaults\");\n    if (!defItem) throw new Error(\"Named range 'RunReportsDefaults' not found.\");\n    const json = String(defItem.getRange().getValue() ?? \"\").trim();\n    if (!json) throw new Error(\"RunReportsDefaults is empty.\");\n    const orig = JSON.parse(json) as {\n        top: number;\n        left: number;\n        width: number;\n        height: number;\n        text: string;\n        borderColor: string;\n        borderWeight: number;\n        fillColor: string;\n        fillTransparency: number;\n    };\n\n    // 4. Find and reset the RunReports shape\n    const ws = workbook.getWorksheet(\"Reports\");\n    if (!ws) throw new Error(\"Worksheet 'Reports' not found.\");\n    const runBtn = ws.getShapes().find(s => s.getName() === \"RunReports\");\n    if (runBtn) {\n        runBtn.setLeft(orig.left);\n        runBtn.setTop(orig.top);\n        runBtn.setWidth(orig.width);\n        runBtn.setHeight(orig.height);\n        runBtn.getFill().setSolidColor(orig.fillColor);\n        runBtn.getFill().setTransparency(orig.fillTransparency);\n        runBtn.getLineFormat().setColor(orig.borderColor);\n        runBtn.getLineFormat().setWeight(orig.borderWeight);\n        runBtn.getTextFrame().getTextRange().setText(orig.text);\n    }\n\n  sheetProtection.protect(\n    {\n      selectionMode: ExcelScript.ProtectionSelectionMode.unlocked, allowFormatCells:     true,\n    allowFormatRows:      true,\n    allowFormatColumns:   true,\n    }, pwd);\n\n    // 5. Re-protect\n    workbook.getProtection().protect(pwd);\n}\n","description":"","parameterInfo":"{\"version\":1,\"originalParameterOrder\":[],\"parameterSchema\":{\"type\":\"object\",\"default\":{},\"x-ms-visibility\":\"internal\"},\"returnSchema\":{\"type\":\"object\",\"properties\":{}},\"signature\":{\"comment\":\"ResetReports.ts v1.0\\nRestores the RunReports button and BusyFlag to their original defaults\\nby reading the JSON stored in the named range RunReportsDefaults.\",\"parameters\":[{\"name\":\"workbook\",\"comment\":\"\"}]}}","apiInfo":"{\"variant\":\"synchronous\",\"variantVersion\":2}"}