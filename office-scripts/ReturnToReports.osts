{"version":"0.3.0","body":"\n/**\n * Hide the Settings sheet and jump to Reports sheet.\n */\nasync function main(workbook: ExcelScript.Workbook) {\n    // 1) Get the Settings sheet\n    const settings = workbook.getWorksheet(\"Settings\");\n    if (!settings) throw new Error(\"Worksheet 'Settings' not found\");\n\n    const reports = workbook.getWorksheet(\"Reports\");\n    if (!reports) throw new Error(\"Worksheet 'Reports' not found\");\n\n    // 3) Activate it\n    reports.activate();\n\n  const pwdItem = workbook.getNames().find(n => n.getName() === \"ProtectionPwd\");\n  if (!pwdItem) throw new Error(\"Named range 'ProtectionPwd' not found\");\n  const pwd = String(pwdItem.getRange().getValue() ?? \"\");\n\n  workbook.getProtection().unprotect(pwd);\n\n    // 2) Unhide it (if it’s hidden)\n    settings.setVisibility(ExcelScript.SheetVisibility.hidden);\n\n  workbook.getProtection().protect(pwd);\n\n}","description":"","parameterInfo":"{\"version\":1,\"originalParameterOrder\":[],\"parameterSchema\":{\"type\":\"object\",\"default\":{},\"x-ms-visibility\":\"internal\"},\"returnSchema\":{\"type\":\"object\",\"properties\":{}},\"signature\":{\"comment\":\"Hide the Settings sheet and jump to Reports sheet.\",\"parameters\":[{\"name\":\"workbook\",\"comment\":\"\"}]}}","apiInfo":"{\"variant\":\"synchronous\",\"variantVersion\":2}"}