{"version":"0.3.0","body":"/**\n * RunReports.ts v5.14\n * Main Office Script to generate\n * pupil reports using the OpenAI API.\n */\n\ninterface CompletionChoice { message: { content: string } }\ninterface CompletionUsage { total_tokens: number }\ninterface CompletionResponse { choices: CompletionChoice[]; usage: CompletionUsage }\ninterface SentimentJSON {\n  attCommentSentiment: string\n  behCommentSentiment: string\n  attTargetSentiment: string\n  behTargetSentiment: string\n}\ninterface StyleProfile {\n  toneDescriptors: string[]\n  avgSentenceLength: number\n  vocabComplexity: string\n  sentenceStructures: string[]\n  commonPhrases: string[]\n}\n\nasync function main(workbook: ExcelScript.Workbook): Promise<void> {\n  // 0. Unprotect workbook\n  const pwdItem = workbook.getNames().find(n => n.getName() === \"ProtectionPwd\")\n  if (!pwdItem) throw new Error(\"Named range 'ProtectionPwd' not found.\")\n  const pwd = String(pwdItem.getRange().getValue() ?? \"\")\n  workbook.getProtection().unprotect(pwd)\n\n  // 1. BUSY FLAG\n  const busyItem = workbook.getNames().find(n => n.getName() === \"BusyFlag\")\n  if (!busyItem) throw new Error(\"Named range 'BusyFlag' not found.\")\n  const busyCell = busyItem.getRange()\n  if ((busyCell.getValue() as string) === \"TRUE\") {\n    workbook.getProtection().protect(pwd)\n    return\n  }\n  busyCell.setValue(\"TRUE\")\n\n  // 2. SHEET & UI SETUP\n  const ws = workbook.getWorksheet(\"Reports\")\n  if (!ws) throw new Error(\"Worksheet 'Reports' not found.\")\n  const log = workbook.getWorksheet(\"TokenLog\")\n  if (!log) throw new Error(\"Worksheet 'TokenLog' not found.\")\n  const shapes = ws.getShapes()\n  const runBtn = shapes.find(s => s.getName() === \"RunReports\")\n\n  //————————————————————————————————\n  // record original RunReports button state\n  const orig = {\n    top: 0, left: 0, width: 0, height: 0, text: \"\",\n    borderColor: \"\" as string,\n    borderWeight: 0 as number,\n    fillColor: \"\" as string,\n    fillTransparency: 0 as number\n  }\n  if (runBtn) {\n    orig.top = runBtn.getTop()\n    orig.left = runBtn.getLeft()\n    orig.width = runBtn.getWidth()\n    orig.height = runBtn.getHeight()\n    orig.text = runBtn.getTextFrame().getTextRange().getText()\n    orig.borderColor = runBtn.getLineFormat().getColor()\n    orig.borderWeight = runBtn.getLineFormat().getWeight()\n    orig.fillColor = runBtn.getFill().getForegroundColor()\n    orig.fillTransparency = runBtn.getFill().getTransparency()\n\n    // flash orange & border, show “Running…”\n    runBtn.getFill().setSolidColor(\"#FFA500\")\n    runBtn.getLineFormat().setColor(\"#FFA500\")\n    runBtn.getTextFrame().getTextRange().setText(\"Running…\")\n\n    // —— Capture defaults on first ever run ——\n    const defaultsItem = workbook.getNames().find(n => n.getName() === \"RunReportsDefaults\")\n    if (defaultsItem) {\n      const cfgCell = defaultsItem.getRange()\n      const existing = String(cfgCell.getValue() ?? \"\").trim()\n      if (!existing) {\n        cfgCell.setValue(JSON.stringify(orig))\n      }\n    }\n    // ————————————————————————————————\n  }\n\n  // 3. HEADER-DRIVEN COLUMN INDEX MAP\n  const headerRange = ws.getUsedRange()\n  if (!headerRange) throw new Error(\"No data on Reports sheet.\")\n  const headerRow = (headerRange.getValues() as (string | number)[][])[0].map(h => String(h).trim())\n  function colIdx(name: string) {\n    const idx = headerRow.findIndex(h => h.toLowerCase() === name.toLowerCase())\n    if (idx < 0) throw new Error(`Column \"${name}\" not found`)\n    return idx\n  }\n  const C = {\n    ID: colIdx(\"ID\"),\n    NAME: colIdx(\"Name\"),\n    GEN: colIdx(\"Gender\"),\n    ATT: colIdx(\"Attitude\"),\n    BEH: colIdx(\"Behaviour\"),\n    ACT: colIdx(\"Extracurricular\"),\n    COMM: colIdx(\"Comment (optional)\"),\n    TARG: colIdx(\"Target\"),\n    OFF: colIdx(\"Off Site?\"),\n    REP: colIdx(\"Report\"),\n    STAT: colIdx(\"Status\"),\n    TOK: colIdx(\"Tokens\"),\n    REGEN: colIdx(\"Regenerate\")\n  } as const\n\n  // 4. ENSURE FORMATTING FOR REP & STAT COLUMNS\n  const usedFull = ws.getUsedRange(true)!\n  const totalRows = usedFull.getRowCount()\n  if (totalRows > 1) {\n    const dataRows = totalRows - 1\n    const repFmt = ws.getRangeByIndexes(1, C.REP, dataRows, 1).getFormat()\n    repFmt.setHorizontalAlignment(ExcelScript.HorizontalAlignment.left)\n    repFmt.setVerticalAlignment(ExcelScript.VerticalAlignment.center)\n    repFmt.setWrapText(true)\n    const statFmt = ws.getRangeByIndexes(1, C.STAT, dataRows, 1).getFormat()\n    statFmt.setHorizontalAlignment(ExcelScript.HorizontalAlignment.center)\n    statFmt.setVerticalAlignment(ExcelScript.VerticalAlignment.center)\n  }\n\n  // identify last data row (non-blank ID)\n  const idVals = ws.getRangeByIndexes(1, C.ID, totalRows - 1, 1).getValues() as (string | number)[][]\n  let lastDataRow = 0\n  for (let i = 0; i < idVals.length; i++) {\n    if (String(idVals[i][0]).trim() !== \"\") lastDataRow = i + 1\n  }\n\n  // 5. COUNT VALID ROWS\n  const values = usedFull.getValues() as (string | number)[][]\n  let totalValid = 0\n  for (let i = 1; i <= lastDataRow; i++) {\n    const pid = String(values[i][C.ID] ?? \"\").trim()\n    const status = String(ws.getCell(i, C.STAT).getValue() ?? \"\").toUpperCase()\n    const regen = Boolean(values[i][C.REGEN])\n    if (pid && (status !== \"COMPLETE\" || regen)) totalValid++\n  }\n\n  // 5.5 Only do the big expand/“Generating…” if there are rows to process\n  if (runBtn && totalValid > 0) {\n    // expand: quadruple width, double height\n    const newWidth = orig.width * 4\n    runBtn.setLeft(orig.left - (newWidth - orig.width))\n    runBtn.setWidth(newWidth)\n    runBtn.setHeight(orig.height * 2)\n\n    // orange background & matching border\n    const orange = \"#FFA500\"\n    runBtn.getFill().setSolidColor(orange)\n    runBtn.getFill().setTransparency(0.3)\n    runBtn.getLineFormat().setColor(orange)\n\n    runBtn.getTextFrame().getTextRange().setText(\n      \"Generating your reports, please be patient...\"\n    )\n  }\n\n  // 6. LOG HELPER\n  function writeLog(pid: string, state: \"OK\" | \"ERROR\" | \"ALERT\", tokens: number | string) {\n    const usedLog = log.getUsedRange()!\n    const rc = usedLog.getRowCount()\n    const first = usedLog.getCell(0, 0).getValue() as string | null\n    const rowIdx = (rc === 1 && first === null) ? 1 : rc + 1\n    log.getRange(`A${rowIdx}:D${rowIdx}`)\n      .setValues([[new Date().toISOString(), pid, state, tokens]])\n  }\n\n  // 7. JSON PARSER\n  function parseJSON<T>(text: string): T {\n    const match = text.match(/\\{[\\s\\S]*\\}/)\n    if (!match) throw new Error(\"No JSON found\")\n    return JSON.parse(match[0]) as T\n  }\n\n  // 8. API & STYLE CONFIG\n  const namesList = workbook.getNames()\n  const apiKey = String(namesList.find(n => n.getName() === \"OpenAI_Key\")!.getRange().getValue())\n  const model = String(namesList.find(n => n.getName() === \"Model\")!.getRange().getValue())\n  const temperature = Number(namesList.find(n => n.getName() === \"Temperature\")!.getRange().getValue())\n  const freqPenalty = Number(namesList.find(n => n.getName() === \"FreqPenalty\")!.getRange().getValue())\n  const presPenalty = Number(namesList.find(n => n.getName() === \"PresPenalty\")!.getRange().getValue())\n  const pronouns: Record<\"M\" | \"F\", [string, string, string]> = {\n    M: [\"he\", \"him\", \"his\"],\n    F: [\"she\", \"her\", \"her\"]\n  }\n\n  // 8a. Character-limit settings\n  const charLimitFlag = Boolean(\n    workbook.getNames()\n      .find(n => n.getName() === \"CharLimitFlag\")!\n      .getRange()\n      .getValue()\n  );\n  const charLimit = Number(\n    workbook.getNames()\n      .find(n => n.getName() === \"CharLimit\")!\n      .getRange()\n      .getValue()\n  );\n\n  const bufferPerc = 0.20;  // 20% buffer\n  const effectiveCharLimit = Math.floor(charLimit * (1 - bufferPerc));\n\n\n  // 9. ROW PROCESSOR\n  async function handleRow(r: number, row: (string | number)[], seq: number) {\n    const pid = String(row[C.ID] ?? \"\").trim()\n    if (!pid) return\n    const statusCell = ws.getCell(r, C.STAT)\n    const existing = String(statusCell.getValue() ?? \"\").toUpperCase()\n    const regen = Boolean(row[C.REGEN])\n    if (existing === \"COMPLETE\" && !regen) return\n\n    const reportCell = ws.getCell(r, C.REP)\n    reportCell.clear(ExcelScript.ClearApplyTo.contents)\n    reportCell.setValue(`AI is now generating your report (${seq} of ${totalValid})...`)\n\n    try {\n      // a) Missing checks\n      const gVal = String(row[C.GEN] ?? \"\").trim()\n      const aVal = String(row[C.ATT] ?? \"\").trim()\n      const bVal = String(row[C.BEH] ?? \"\").trim()\n      const missing: string[] = []\n      if (!gVal) missing.push(\"Gender\")\n      if (!aVal) missing.push(\"Attitude\")\n      if (!bVal) missing.push(\"Behaviour\")\n      if (missing.length) {\n        statusCell.setValue(\"Missing: \" + missing.join(\", \"))\n        statusCell.getFormat().getFill().setColor(\"#FFC7CE\")\n        const hl = \"#FFEB9C\"\n        if (missing.includes(\"Gender\")) ws.getCell(r, C.GEN).getFormat().getFill().setColor(hl)\n        if (missing.includes(\"Attitude\")) ws.getCell(r, C.ATT).getFormat().getFill().setColor(hl)\n        if (missing.includes(\"Behaviour\")) ws.getCell(r, C.BEH).getFormat().getFill().setColor(hl)\n        reportCell.clear(ExcelScript.ClearApplyTo.contents)\n        ws.getCell(r, C.TOK).clear(ExcelScript.ClearApplyTo.contents)\n        return\n      }\n      statusCell.clear(ExcelScript.ClearApplyTo.contents)\n      statusCell.getFormat().getFill().clear()\n      ws.getCell(r, C.GEN).getFormat().getFill().clear()\n      ws.getCell(r, C.ATT).getFormat().getFill().clear()\n      ws.getCell(r, C.BEH).getFormat().getFill().clear()\n\n      // b) Off-site shortcut\n      if (String(row[C.OFF] ?? \"\").toUpperCase() === \"YES\") {\n        const full = String(row[C.NAME] ?? \"\")\n        const first = (full.match(/^([A-Za-z'-]+)/) || [full])[1]\n        reportCell.setValue(`${first} did not attend form time this year.`)\n        statusCell.setValue(\"Complete\")\n        ws.getCell(r, C.TOK).setValue(0)\n        ws.getCell(r, C.REGEN).setValue(false)\n        writeLog(pid, \"OK\", 0)\n        return\n      }\n\n      // — Determine the real first name for exact character counting —\n      const pupilName = (String(row[C.NAME]).match(/^([A-Za-z'-]+)/) || [\"\", \"\"])[1];\n      // use the actual name everywhere instead of the generic placeholder\n\n\n      // c) Prepare data\n      const placeholder = \"<<PUPIL_NAME>>\"\n      const p = pronouns[String(row[C.GEN]).toUpperCase() as \"M\" | \"F\"]\n      const subj = p[0], objPron = p[1], poss = p[2]\n      const attNum = Number(row[C.ATT]), behNum = Number(row[C.BEH])\n      function gradeWord(n: number) {\n        switch (Math.round(n)) {\n          case 1: return \"outstanding\"\n          case 2: return \"good\"\n          case 3: return \"an area for improvement\"\n          case 4: return \"a cause for concern\"\n          default: return \"unrated\"\n        }\n      }\n      const attDesc = gradeWord(attNum), behDesc = gradeWord(behNum)\n      const clean = (t: string) => t.trim().replace(/^[\\\"'\\s]+|[\\\"'\\s\\.]+$/g, \"\")\n      const actTxt = clean(String(row[C.ACT] ?? \"\")),\n        targTxt = clean(String(row[C.TARG] ?? \"\")),\n        commTxt = clean(String(row[C.COMM] ?? \"\"))\n\n      // d) Sentiment classification\n      const sentimentPrompt = `\nYou are a sentiment analysis assistant. Given the following tutor inputs,\noutput a JSON object with EXACTLY these keys:\n  • attCommentSentiment\n  • behCommentSentiment\n  • attTargetSentiment\n  • behTargetSentiment\n\nEach value must be one of \"positive\", \"negative\", or \"neutral\".\n\n*Do not alter, normalize, paraphrase, or correct the text in any way.*\nAnalyze exactly the words given.\n\n**When assigning:**\n- attCommentSentiment = sentiment about *attitude* only (if the comment doesn’t mention attitude, return \"neutral\").\n- behCommentSentiment = sentiment about *behaviour* only (if the comment doesn’t mention behaviour, return \"neutral\").\n- attTargetSentiment and behTargetSentiment follow the same rules for the Target text.\n\n**If the text is phrased as an instruction to improve (e.g. \"improve behaviour\"), treat that as a negative sentiment, since it indicates an area for improvement.**\n\nExtra Comment: \"\"\"${commTxt}\"\"\"\nTarget: \"\"\"${targTxt}\"\"\"\n`\n      const sentResp = await fetch(\"https://api.openai.com/v1/chat/completions\", {\n        method: \"POST\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          Authorization: `Bearer ${apiKey}`\n        },\n        body: JSON.stringify({\n          model, temperature: 0, frequency_penalty: 0, presence_penalty: 0,\n          messages: [{ role: \"user\", content: sentimentPrompt }],\n          max_tokens: 128\n        })\n      })\n      if (!sentResp.ok) throw new Error(await sentResp.text())\n      const sentJson = await sentResp.json() as CompletionResponse\n      const {\n        attCommentSentiment, behCommentSentiment,\n        attTargetSentiment, behTargetSentiment\n      } = parseJSON<SentimentJSON>(sentJson.choices[0].message.content)\n\n      // e) Polarity checks\n      function polarityOf(desc: string) {\n        return ([\"outstanding\", \"good\"].includes(desc) ? \"positive\" : \"negative\")\n      }\n      const attPol = polarityOf(attDesc), behPol = polarityOf(behDesc)\n\n      if (commTxt && attCommentSentiment !== \"neutral\" && attCommentSentiment !== attPol) {\n        reportCell.setValue(\"ALERT: Comment sentiment contradicts the attitude grade.\")\n        statusCell.setValue(\"ALERT\")\n        ws.getCell(r, C.TOK).setValue(sentJson.usage.total_tokens)\n        ws.getCell(r, C.REGEN).setValue(true)\n        writeLog(pid, \"ALERT\", sentJson.usage.total_tokens)\n        return\n      }\n      if (commTxt && behCommentSentiment !== \"neutral\" && behCommentSentiment !== behPol) {\n        reportCell.setValue(\"ALERT: Comment sentiment contradicts the behaviour grade.\")\n        statusCell.setValue(\"ALERT\")\n        ws.getCell(r, C.TOK).setValue(sentJson.usage.total_tokens)\n        ws.getCell(r, C.REGEN).setValue(true)\n        writeLog(pid, \"ALERT\", sentJson.usage.total_tokens)\n        return\n      }\n      if (targTxt && attTargetSentiment !== \"neutral\" && attTargetSentiment !== attPol) {\n        reportCell.setValue(\"ALERT: Target sentiment contradicts the attitude grade.\")\n        statusCell.setValue(\"ALERT\")\n        ws.getCell(r, C.TOK).setValue(sentJson.usage.total_tokens)\n        ws.getCell(r, C.REGEN).setValue(true)\n        writeLog(pid, \"ALERT\", sentJson.usage.total_tokens)\n        return\n      }\n      if (targTxt && behTargetSentiment !== \"neutral\" && behTargetSentiment !== behPol) {\n        reportCell.setValue(\"ALERT: Target sentiment contradicts the behaviour grade.\")\n        statusCell.setValue(\"ALERT\")\n        ws.getCell(r, C.TOK).setValue(sentJson.usage.total_tokens)\n        ws.getCell(r, C.REGEN).setValue(true)\n        writeLog(pid, \"ALERT\", sentJson.usage.total_tokens)\n        return\n      }\n\n      // f) Build report lines\n      const reportLines: string[] = [];\n      \n         // — If flagged, inject a strict character‐count requirement —\n         if (charLimitFlag) {\n            reportLines.push(\n              `*Hard limit:* After you craft exactly four sentences, count every character (including white spaces). The JSON \"comment\" value **must be no more than ${effectiveCharLimit} characters including white space**.  \n If it exceeds, shorten or paraphrase the sentences—keeping all required descriptors—to fit within this exact limit.`\n               );\n           }\n\n      reportLines.push(\n           \"You are a Form tutor writing a brief, 4-sentence, yearly Form-time report. Do not write a subject-specific report.\",\n        \"Output only the JSON object with key \\\"comment\\\"—no additional text or explanation.\",\n        \"Ensure exactly four sentences—do not split, merge, or change them.\",\n        `Attitude grade ${attNum} maps to \"${attDesc}\" and Behaviour grade ${behNum} maps to \"${behDesc}\". Use these concepts accurately.`,\n        `The pupil’s pronouns are: subject = \"${subj}\", object = \"${objPron}\", possessive = \"${poss}\".`,\n        `1. Begin the first sentence with \"${placeholder}\", and describe their ${attDesc} attitude and ${behDesc} behaviour in form in a positive, natural-sounding way — feel free to vary the sentence structure as long as it starts with their name.`,\n        `2. Begin the second sentence with \"${subj.charAt(0).toUpperCase() + subj.slice(1)}\" to reaffirm that overview.`,\n        actTxt\n          ? `3. Begin the third sentence with \"${placeholder}'s\" to celebrate their engagement in extra-curricular activities, paraphrasing the list \"${actTxt}\" into a natural-sounding phrase.`\n          : `3. Begin the third sentence with \"${placeholder}\" to note positively that no extra-curricular engagement was recorded.`,\n        targTxt\n          ? `4. Begin the fourth sentence with \"${subj.charAt(0).toUpperCase() + subj.slice(1)}\" to set a positively-phrased target, paraphrasing: \"${targTxt}\".`\n          : `4. Begin the fourth sentence with \"${subj.charAt(0).toUpperCase() + subj.slice(1)}\" to set an appropriate target based on attitude & behaviour.`,\n        commTxt\n          ? `Include this extra comment exactly as given: \"${commTxt}\".`\n          : `Do not invent or include any extra comments.`,\n        \"Never invent or embellish—only use the provided information.\",\n        \"Paraphrase only the target; do not copy word-for-word.\"\n      );\n\n      // g) Style emulation\n      const emRaw = workbook.getNames().find(n => n.getName() === \"EnableEmulation\")!.getRange().getValue()\n      const emulate = typeof emRaw === \"boolean\" ? emRaw : (String(emRaw).toUpperCase() === \"TRUE\")\n      let styleProfile: StyleProfile | null = null\n      if (emulate) {\n        try {\n          styleProfile = JSON.parse(\n            String(workbook.getNames().find(n => n.getName() === \"StyleProfileJSON\")!.getRange().getValue())\n          ) as StyleProfile\n        } catch {\n          styleProfile = null\n        }\n        if (styleProfile === null) {\n          reportCell.setValue(\"ALERT: Style emulation enabled but no valid profile found.\")\n          statusCell.setValue(\"ALERT\")\n          ws.getCell(r, C.TOK).setValue(0)\n          ws.getCell(r, C.REGEN).setValue(true)\n          writeLog(pid, \"ALERT\", 0)\n          return\n        }\n      }\n\n      // h) Retry logic for AI\n      const maxAttempts = 3\n      let finalComment = \"\"\n      let usageTokens = 0\n      for (let attempt = 1; attempt <= maxAttempts; attempt++) {\n        const messages: { role: string, content: string }[] = []\n        if (emulate && styleProfile) {\n          let sys = \"You **must** output **exactly four sentences**. \"\n          if (styleProfile.toneDescriptors.length) {\n            sys += `Adopt a tone described by: ${styleProfile.toneDescriptors.join(\", \")}. `\n          }\n          sys += `Aim for an average sentence length of about ${styleProfile.avgSentenceLength} words, using ${styleProfile.vocabComplexity}-level vocabulary. `\n          sys += `Vary your sentences among these structures: ${styleProfile.sentenceStructures.join(\", \")}. `\n          if (styleProfile.commonPhrases.length) {\n            sys += `And include at least one of these exact common phrases: ${styleProfile.commonPhrases.join(\", \")}. `\n          }\n          sys += \"Do not alter the required report structure in any other way.\"\n\n          // — enforce exact string.length semantics —\n          if (charLimitFlag) {\n            sys += ` Also, enforce a hard cap by measuring the final JSON \"comment\" value as a raw string length (i.e. string.length in code), counting **every single character** — letters, numbers, punctuation, **and spaces** — and ensure it is **no more than ${effectiveCharLimit} characters**. If it exceeds, rewrite until it fits exactly within that limit.`;\n          }\n\n          messages.push({ role: \"system\", content: sys })\n        }\n        messages.push({ role: \"user\", content: reportLines.join(\"\\n\") })\n        const resp = await fetch(\"https://api.openai.com/v1/chat/completions\", {\n          method: \"POST\",\n          headers: { \"Content-Type\": \"application/json\", Authorization: `Bearer ${apiKey}` },\n          body: JSON.stringify({\n            model,\n            temperature,\n            frequency_penalty: freqPenalty,\n            presence_penalty: presPenalty,\n            messages,\n            max_tokens: 256\n          })\n        })\n        if (!resp.ok) throw new Error(await resp.text())\n        const jr = (await resp.json()) as CompletionResponse\n        usageTokens = jr.usage.total_tokens\n        finalComment = parseJSON<{ comment: string }>(jr.choices[0].message.content).comment.replace(\n          /<<PUPIL_NAME>>/g,\n          (String(row[C.NAME]).match(/^([A-Za-z'-]+)/) || [\"\"])[1]\n        )\n\n        const lc = finalComment.toLowerCase()\n        if (lc.includes(attDesc.toLowerCase()) && lc.includes(behDesc.toLowerCase())) {\n          break\n        }\n        if (attempt === maxAttempts) {\n          reportCell.setValue(`ALERT: AI failed to include required descriptors after ${maxAttempts} attempts.`)\n          statusCell.setValue(\"ALERT\")\n          ws.getCell(r, C.TOK).setValue(usageTokens)\n          ws.getCell(r, C.REGEN).setValue(true)\n          writeLog(pid, \"ALERT\", usageTokens)\n          return\n        }\n      }\n\n      // i) Final write-out & formatting\n      reportCell.setValue(finalComment)\n      statusCell.setValue(\"Complete\")\n      ws.getCell(r, C.TOK).setValue(usageTokens)\n      ws.getCell(r, C.REGEN).setValue(false)\n      writeLog(pid, \"OK\", usageTokens)\n      const repFmt = ws.getRangeByIndexes(r, C.REP, 1, 1).getFormat()\n      repFmt.setWrapText(true)\n      repFmt.autofitRows()\n      const fittedH = repFmt.getRowHeight()\n      repFmt.setRowHeight(fittedH + 50)\n      repFmt.setIndentLevel(3)\n\n    } catch (e: unknown) {\n      const msg = e instanceof Error ? e.message : String(e)\n      const statusCell = ws.getCell(r, C.STAT)\n      statusCell.setValue(\"ERROR: \" + msg)\n      statusCell.getFormat().getFill().setColor(\"#FFC7CE\")\n      ws.getCell(r, C.TOK).clear(ExcelScript.ClearApplyTo.contents)\n      ws.getCell(r, C.REGEN).setValue(false)\n      writeLog(pid, \"ERROR\", msg)\n    }\n  }\n\n  // 10. LOOP THROUGH ROWS\n  let seq = 0\n  for (let i = 1; i <= lastDataRow; i++) {\n    const pid = String(values[i][C.ID] ?? \"\").trim()\n    const status = String(ws.getCell(i, C.STAT).getValue() ?? \"\").toUpperCase()\n    const regen = Boolean(values[i][C.REGEN])\n    if (pid && (status !== \"COMPLETE\" || regen)) {\n      seq++\n      await handleRow(i, values[i], seq)\n    }\n  }\n\n  // 11. CLEANUP & RE-PROTECT\n  if (runBtn) {\n    runBtn.setLeft(orig.left)\n    runBtn.setTop(orig.top)\n    runBtn.setWidth(orig.width)\n    runBtn.setHeight(orig.height)\n    runBtn.getFill().setSolidColor(orig.fillColor)\n    runBtn.getFill().setTransparency(orig.fillTransparency)\n    runBtn.getLineFormat().setColor(orig.borderColor)\n    runBtn.getLineFormat().setWeight(orig.borderWeight)\n    runBtn.getTextFrame().getTextRange().setText(orig.text)\n  }\n  busyCell.setValue(\"FALSE\")\n  workbook.getProtection().protect(pwd)\n}","description":"","parameterInfo":"{\"version\":1,\"originalParameterOrder\":[],\"parameterSchema\":{\"type\":\"object\",\"default\":{},\"x-ms-visibility\":\"internal\"},\"returnSchema\":{\"type\":\"object\",\"properties\":{}},\"signature\":{\"comment\":\"\",\"parameters\":[{\"name\":\"workbook\",\"comment\":\"\"}]}}","apiInfo":"{\"variant\":\"synchronous\",\"variantVersion\":2}"}