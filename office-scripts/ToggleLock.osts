{"version":"0.3.0","body":"/**\n * TOGGLE LOCK\n * IT helper: hide/unhide the Config sheet and toggle protection\n * on Input in one click.\n */\nfunction main(workbook: ExcelScript.Workbook) {\n  const cfg = workbook.getWorksheet(\"Config\");\n  const hidden = cfg.getVisibility() === ExcelScript.SheetVisibility.hidden;\n\n  cfg.setVisibility(hidden\n    ? ExcelScript.SheetVisibility.visible\n    : ExcelScript.SheetVisibility.hidden);\n\n  const ws = workbook.getWorksheet(\"Reports\");\n  hidden ? ws.getProtection().unprotect()\n    : ws.getProtection().protect();\n}\n","description":"","parameterInfo":"{\"version\":1,\"originalParameterOrder\":[],\"parameterSchema\":{\"type\":\"object\",\"default\":{},\"x-ms-visibility\":\"internal\"},\"returnSchema\":{\"type\":\"object\",\"properties\":{}},\"signature\":{\"comment\":\"TOGGLE LOCK\\nIT helper: hide/unhide the Config sheet and toggle protection\\non Input in one click.\",\"parameters\":[{\"name\":\"workbook\",\"comment\":\"\"}]}}","apiInfo":"{\"variant\":\"synchronous\",\"variantVersion\":2}"}