{"version":"0.3.0","body":"/**\n * TOGGLE REGENERATE ALL (header-driven, ID-limited)\n * Toggles the Regenerate flag for each “Complete” row that has an ID,\n * based on whether any are currently unflagged.\n */\nfunction main(workbook: ExcelScript.Workbook) {\n    const ws = workbook.getWorksheet(\"Reports\");\n    if (!ws) throw new Error(\"Worksheet 'Reports' not found\");\n\n    // ————————————————————————————————\n    // 1) Read the full used range & header row\n    const used = ws.getUsedRange();\n    if (!used) throw new Error(\"No used range—sheet might be empty\");\n    const allValues = used.getValues() as (string | number)[][];\n    const headerValues = allValues[0].map(h => String(h).trim());\n    if (headerValues.length === 0) throw new Error(\"Header row is empty\");\n\n    // 2) Build a column-name → index map\n    const colIdx = (name: string) => {\n        const i = headerValues.findIndex(h => h.toLowerCase() === name.toLowerCase());\n        if (i < 0) throw new Error(`Column \"${name}\" not found in header row`);\n        return i;\n    };\n    const C = {\n        ID: colIdx(\"ID\"),\n        REP: colIdx(\"Report\"),\n        STAT: colIdx(\"Status\"),\n        REGEN: colIdx(\"Regenerate\")\n    } as const;\n\n    const rowCount = used.getRowCount();\n\n    // ————————————————————————————————\n    // 3) Find the last data row by checking non-blank IDs\n    const idVals = ws\n        .getRangeByIndexes(1, C.ID, rowCount - 1, 1)\n        .getValues() as (string | number)[][];\n    let lastDataRow = 0;\n    for (let i = 0; i < idVals.length; i++) {\n        if (String(idVals[i][0]).trim() !== \"\") {\n            lastDataRow = i + 1; // +1 to account for header row at index 0\n        }\n    }\n    if (lastDataRow < 1) return;  // no pupil data present\n\n    // ————————————————————————————————\n    // 4) Determine toggle direction: are there any unflagged COMPLETE rows?\n    let anyUnflagged = false;\n    for (let r = 1; r <= lastDataRow; r++) {\n        const status = String(ws.getCell(r, C.STAT).getValue() ?? \"\").toUpperCase();\n        const report = String(ws.getCell(r, C.REP).getValue() ?? \"\").trim();\n        const flagged = Boolean(ws.getCell(r, C.REGEN).getValue());\n        if (status === \"COMPLETE\" && report && !flagged) {\n            anyUnflagged = true;\n            break;\n        }\n    }\n\n    // ————————————————————————————————\n    // 5) Toggle Regenerate flag on each COMPLETE row with an ID\n    for (let r = 1; r <= lastDataRow; r++) {\n        const status = String(ws.getCell(r, C.STAT).getValue() ?? \"\").toUpperCase();\n        const report = String(ws.getCell(r, C.REP).getValue() ?? \"\").trim();\n        if (status === \"COMPLETE\" && report) {\n            ws.getCell(r, C.REGEN).setValue(anyUnflagged);\n        }\n    }\n}","description":"","parameterInfo":"{\"version\":1,\"originalParameterOrder\":[],\"parameterSchema\":{\"type\":\"object\",\"default\":{},\"x-ms-visibility\":\"internal\"},\"returnSchema\":{\"type\":\"object\",\"properties\":{}},\"signature\":{\"comment\":\"TOGGLE REGENERATE ALL (header-driven, ID-limited)\\nToggles the Regenerate flag for each “Complete” row that has an ID,\\nbased on whether any are currently unflagged.\",\"parameters\":[{\"name\":\"workbook\",\"comment\":\"\"}]}}","apiInfo":"{\"variant\":\"synchronous\",\"variantVersion\":2}"}